# ─────────────────────────────────────────────────────────────
# 이 파일을 복사해 .env.local 로 만든 뒤 값을 채우세요. (.env.local 은 Git에 올라가지 않습니다)
# ─────────────────────────────────────────────────────────────

# [서버 전용] YouTube Data API v3 키 — VITE_ 접두사가 없으므로 브라우저 코드에 포함되지 않습니다.
# 로컬 개발 서버(npm run dev / npm run preview)의 프록시만 이 값을 읽습니다.
# 비워 두면 '제한 모드'로 동작합니다 (개별 영상: 제목·썸네일만, 재생목록: 최근 15개만).
YOUTUBE_API_KEY=

# [서버 전용] 하루 사용 상한(단위). 무료 할당량(10,000)보다 낮게 두어 초과를 미리 막습니다.
YOUTUBE_DAILY_UNIT_CAP=9000

# [브라우저 공개 가능] 프록시를 별도 주소(예: Cloudflare Worker)에 배포했을 때만 설정.
# 비워 두면 같은 서버(/api/youtube)를 사용합니다. 비밀정보를 VITE_ 변수에 넣지 마세요.
VITE_API_BASE_URL=
